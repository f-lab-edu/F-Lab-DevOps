{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "mode": {
      "const": "diagnostics"
    },
    "replicaCount": {
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always"
          ]
        }
      },
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        }
      },
      "required": [
        "bindings",
        "runtime"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        }
      },
      "required": [
        "storageClassName",
        "size"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiServerCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$",
            "not": {
              "const": "0.0.0.0/32"
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "namespace",
            "podLabels"
          ]
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "namespace",
            "podLabels",
            "port"
          ]
        }
      },
      "required": [
        "apiServerCIDRs",
        "dns",
        "prometheus"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    }
  },
  "required": [
    "enabled",
    "mode",
    "replicaCount",
    "image",
    "config",
    "persistence",
    "network",
    "resources"
  ],
  "$defs": {
    "ArgoBinding": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        },
        "application": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Application",
          "type": "string"
        },
        "repo_url": {
          "maxLength": 512,
          "pattern": "^https://[A-Za-z0-9./_-]+\\.git$",
          "title": "Repo Url",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "destination_server": {
          "default": "https://kubernetes.default.svc",
          "title": "Destination Server",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "application",
        "repo_url",
        "path"
      ],
      "title": "ArgoBinding",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]{0,78}[a-z0-9]$",
          "title": "Cluster Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        },
        "workload": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Workload",
          "type": "string"
        },
        "service": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Service",
          "type": "string"
        },
        "environment": {
          "enum": [
            "practice",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "workload",
        "service",
        "environment"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetBinding": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Alias",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "pod_selector": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 10,
          "minProperties": 1,
          "title": "Pod Selector",
          "type": "object"
        },
        "container": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Container",
          "type": "string"
        },
        "kubernetes_connection": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Kubernetes Connection",
          "type": "string"
        },
        "prometheus_connection": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Prometheus Connection",
          "type": "string"
        },
        "argo": {
          "$ref": "#/$defs/ArgoBinding"
        },
        "routes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        },
        "operations": {
          "items": {
            "enum": [
              "select_one",
              "select_all",
              "insert",
              "delete"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "alias",
        "target",
        "pod_selector",
        "container",
        "kubernetes_connection",
        "prometheus_connection",
        "argo",
        "routes",
        "operations"
      ],
      "title": "TargetBinding",
      "type": "object"
    },
    "CollectionLimits": {
      "additionalProperties": false,
      "properties": {
        "lookback_seconds": {
          "default": 900,
          "maximum": 900,
          "minimum": 60,
          "title": "Lookback Seconds",
          "type": "integer"
        },
        "deadline_seconds": {
          "default": 60,
          "maximum": 60,
          "minimum": 1,
          "title": "Deadline Seconds",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "integer"
        },
        "max_pods": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Pods",
          "type": "integer"
        },
        "max_events": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Events",
          "type": "integer"
        },
        "log_lines_per_pod": {
          "default": 200,
          "maximum": 200,
          "minimum": 1,
          "title": "Log Lines Per Pod",
          "type": "integer"
        },
        "raw_log_bytes": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1,
          "title": "Raw Log Bytes",
          "type": "integer"
        },
        "response_bytes": {
          "default": 262144,
          "maximum": 262144,
          "minimum": 1,
          "title": "Response Bytes",
          "type": "integer"
        },
        "total_response_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Total Response Bytes",
          "type": "integer"
        },
        "payload_bytes": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1,
          "title": "Payload Bytes",
          "type": "integer"
        },
        "bundle_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Bundle Bytes",
          "type": "integer"
        },
        "max_items": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "future_tolerance_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 0,
          "title": "Future Tolerance Seconds",
          "type": "integer"
        }
      },
      "title": "CollectionLimits",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "kubernetes",
            "prometheus"
          ],
          "title": "Kind",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "token_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token File"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Connection",
      "type": "object"
    },
    "ScrapePolicy": {
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {
          "const": 30,
          "default": 30,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "minimum_samples": {
          "default": 8,
          "maximum": 10,
          "minimum": 1,
          "title": "Minimum Samples",
          "type": "integer"
        },
        "max_age_seconds": {
          "default": 60,
          "maximum": 60,
          "minimum": 30,
          "title": "Max Age Seconds",
          "type": "integer"
        }
      },
      "title": "ScrapePolicy",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "persistence": {
            "properties": {
              "storageClassName": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "config": {
            "properties": {
              "bindings": {
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": 1,
                    "title": "Schema Version",
                    "type": "integer"
                  },
                  "bindings": {
                    "items": {
                      "$ref": "#/$defs/TargetBinding"
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "title": "Bindings",
                    "type": "array"
                  }
                },
                "required": [
                  "schema_version",
                  "bindings"
                ],
                "title": "BindingRegistry",
                "type": "object"
              },
              "runtime": {
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": 1,
                    "title": "Schema Version",
                    "type": "integer"
                  },
                  "collector_version": {
                    "const": "captured-snapshot-v1",
                    "default": "captured-snapshot-v1",
                    "title": "Collector Version",
                    "type": "string"
                  },
                  "llm_enabled": {
                    "const": false,
                    "default": false,
                    "title": "Llm Enabled",
                    "type": "boolean"
                  },
                  "per_incident_budget_usd": {
                    "default": 0.1,
                    "exclusiveMinimum": 0,
                    "maximum": 0.1,
                    "title": "Per Incident Budget Usd",
                    "type": "number"
                  },
                  "daily_budget_usd": {
                    "default": 1.0,
                    "exclusiveMinimum": 0,
                    "maximum": 1.0,
                    "title": "Daily Budget Usd",
                    "type": "number"
                  },
                  "connections": {
                    "maxProperties": 20,
                    "minProperties": 1,
                    "patternProperties": {
                      "^[a-z][a-z0-9-]{0,62}$": {
                        "$ref": "#/$defs/Connection"
                      }
                    },
                    "title": "Connections",
                    "type": "object"
                  },
                  "limits": {
                    "$ref": "#/$defs/CollectionLimits"
                  },
                  "scrape": {
                    "$ref": "#/$defs/ScrapePolicy"
                  }
                },
                "required": [
                  "schema_version",
                  "connections"
                ],
                "title": "BRuntime",
                "type": "object"
              }
            }
          },
          "network": {
            "properties": {
              "apiServerCIDRs": {
                "minItems": 1
              },
              "dns": {
                "properties": {
                  "podLabels": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "prometheus": {
                "properties": {
                  "podLabels": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
