{
  "schema_version": 1,
  "bindings": [
    {
      "alias": "url-shortener-practice",
      "target": {
        "cluster_id": "practice-eks-example",
        "namespace": "url-shortener",
        "workload": "url-shortener-api",
        "service": "url-shortener-svc",
        "environment": "practice"
      },
      "pod_selector": {
        "app": "url-shortener-api"
      },
      "container": "api",
      "kubernetes_connection": "practice-kubernetes",
      "prometheus_connection": "practice-prometheus",
      "argo": {
        "namespace": "argocd",
        "application": "url-shortener",
        "repo_url": "https://github.com/f-lab-edu/F-Lab-DevOps.git",
        "path": "url-shortener/url-shortener-chart",
        "destination_server": "https://kubernetes.default.svc"
      },
      "routes": [
        "/items",
        "/items/{item_id}",
        "/items/_db"
      ],
      "operations": [
        "select_one",
        "select_all",
        "insert",
        "delete"
      ]
    }
  ]
}
