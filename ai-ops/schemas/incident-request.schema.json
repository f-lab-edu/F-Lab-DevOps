{
  "$defs": {
    "Target": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]{0,78}[a-z0-9]$",
          "title": "Cluster Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        },
        "workload": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Workload",
          "type": "string"
        },
        "service": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Service",
          "type": "string"
        },
        "environment": {
          "enum": [
            "practice",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "namespace",
        "workload",
        "service",
        "environment"
      ],
      "title": "Target",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "incident_id": {
      "pattern": "^inc-[0-9a-f]{32}$",
      "title": "Incident Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "source": {
      "const": "manual_replay",
      "title": "Source",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Hash",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "request_id",
    "source",
    "target",
    "question",
    "window",
    "bundle_hash",
    "requested_at"
  ],
  "title": "IncidentRequest",
  "type": "object"
}
