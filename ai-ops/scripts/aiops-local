#!/bin/sh
set -eu

# 프로젝트 의존성이 준비된 Python을 찾아 저장소를 설치하지 않고 실행한다.
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for task_python in "${AI_OPS_PYTHON:-}" \
    "${HOME}/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3" \
    python3.13 python3.12 python3.11; do
    if [ -n "$task_python" ] && command -v "$task_python" >/dev/null 2>&1 && \
        "$task_python" -c 'import sys, pydantic; assert sys.version_info >= (3, 11) and pydantic.__version__ == "2.13.5"' >/dev/null 2>&1; then
        PYTHONPATH="$task_root/src" exec "$task_python" -m ai_ops "$@"
    fi
done

printf '%s\n' 'Python 3.11+ 및 Pydantic 2.13.5가 필요합니다. 준비된 Python 경로를 AI_OPS_PYTHON에 지정해 주세요.' >&2
exit 2
